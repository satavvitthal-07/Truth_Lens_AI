# Reviewed educational detector. Its CC BY-NC 3.0 terms restrict use to
# non-commercial contexts; the model is SDXL-focused, not a universal detector.
TRUTHLENS_MODEL_ID=Organika/sdxl-detector
TRUTHLENS_MODEL_REVISION=b37fede8562cb72b89ec201c0987f96ba21b518a
TRUTHLENS_MODEL_VERIFIED=true
TRUTHLENS_AI_LABELS=artificial

# Set TRUTHLENS_MODEL_VERIFIED=false to disable model loading and inference.

# Optional comma-separated browser origins for a separate frontend dev server.
TRUTHLENS_CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000
# Optional database path. Defaults to backend/truthlens.sqlite3.
# TRUTHLENS_DATABASE=

# Uploaded media is retained locally until its analysis is deleted.
# Defaults to backend/uploads; keep this directory private and out of Git.
# TRUTHLENS_UPLOAD_DIR=
# Total upload cap (50 MB by default); image/video limits also apply.
# TRUTHLENS_MAX_UPLOAD_BYTES=52428800
# Optional lower per-format limits:
# TRUTHLENS_IMAGE_MAX_BYTES=10485760
# TRUTHLENS_VIDEO_MAX_BYTES=52428800
